{
  "name": "fast-jev-compaction",
  "version": "0.3.0",
  "description": "Verbatim context compaction for OpenCode, decided by Jev: no summary, only tool calls and results that are no longer needed are removed.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": "./src/opencode/index.ts",
    "./lib": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "README.ru.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && npm run typecheck:bench",
    "typecheck:bench": "tsc -p tsconfig.bench.json",
    "test": "vitest run",
    "bench": "tsx bench/run.ts",
    "bench:stub": "tsx bench/run.ts --transport stub",
    "bench:e2e": "tsx bench/e2e.ts",
    "bench:stub-server": "tsx bench/stub-server.ts",
    "extract": "tsx bin/extract-sessions.ts",
    "trial": "tsx bin/trial.ts",
    "demo": "tsx examples/demo.ts"
  },
  "dependencies": {
    "@opencode/plugin": "^2.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
